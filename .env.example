# Copy to .env.local for local work. Never commit real values.
# Public site address (used for links and social cards)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "production" hides the preview ribbon and lets search engines in
NEXT_PUBLIC_SITE_ENV=preview

# Supabase (Project Settings > API Keys). Both are public values.
# Leave blank and the site still runs; sign-in shows "not switched on yet".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe billing (server only, never NEXT_PUBLIC). Use a restricted rk_test_ key while testing.
# Leave blank and My account says card billing "opens soon". See docs/stripe-billing.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Supabase service role, server only. Needed for billing and Clear Signal sending.
SUPABASE_SERVICE_ROLE_KEY=
